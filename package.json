{
  "name": "prime-physio",
  "private": true,
  "version": "0.2.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "npm run dev --workspace @prime-physio/web",
    "dev:mobile": "npm run start --workspace @prime-physio/mobile",
    "ios": "npm run ios --workspace @prime-physio/mobile",
    "android": "npm run android --workspace @prime-physio/mobile",
    "build:web": "npm run build --workspace @prime-physio/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": { "node": ">=20.0.0" }
}